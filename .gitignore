def load_recipients():
    if os.path.exists(RECIPIENTS_FILE):
        with open(RECIPIENTS_FILE) as f:
            return json.load(f)
    return ["erick202080@gmail.com"]

def save_recipients(r):
    with open(RECIPIENTS_FILE, "w") as f:
        json.dump(r, f, indent=2)

# I changed this a bit 
class EWBEmailApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("EWB-UH Email Blast")
        self.geometry("1160x940")
        self.minsize(980, 760)
        self.configure(bg=C["bg"])
        _resolve_ui_font()  # pick Roboto or a clean fallback before building UI
        self.recipients = load_recipients()
        self.attached_images = []  # list of (filename, bytes, cid, is_image)
        self._build_ui()

    def _build_ui(self):
        self._build_header()

        # Tab bar
        tab_bar = tk.Frame(self, bg=C["panel"],
                           highlightbackground=C["border"],
                           highlightthickness=0)
        tab_bar.pack(fill="x")
        tk.Frame(self, bg=C["border"], height=1).pack(fill="x")

        self._tab_frames = {}
        self._tab_btns   = {}

        container = tk.Frame(self, bg=C["bg"])
        container.pack(fill="both", expand=True)

        for tab_name in ("Compose", "How It Works"):
            frame = tk.Frame(container, bg=C["bg"])
            frame.place(relx=0, rely=0, relwidth=1, relheight=1)
            self._tab_frames[tab_name] = frame

            btn = tk.Button(
                tab_bar, text=tab_name,
                font=(_RB, 13, "bold"),
                relief="flat", bd=0,
                padx=28, pady=13,
                cursor="hand2",
                anchor="center",
                justify="center",
                command=lambda n=tab_name: self._show_tab(n)
            )
            btn.pack(side="left")
            self._tab_btns[tab_name] = btn

        # Build content into each tab
        self._build_compose_tab(self._tab_frames["Compose"])
        self._build_howto_tab(self._tab_frames["How It Works"])
        self._show_tab("Compose")

    def _show_tab(self, name):
        for n, f in self._tab_frames.items():
            f.lower()
        self._tab_frames[name].lift()
        for n, b in self._tab_btns.items():
            if n == name:
                b.config(
                    bg=C["accent"], fg="#FFFFFF",
                    activebackground=C["accent"],
                    activeforeground="#FFFFFF",
                    font=(_RB, 13, "bold"),
                    relief="flat", bd=0,
                    highlightthickness=0,
                    padx=28, pady=13)
            else:
                b.config(
                    bg=C["panel"], fg="#000000",
                    activebackground=C["accent_light"],
                    activeforeground="#000000",
                    font=(_RB, 13, "bold"),
                    relief="flat", bd=0,
                    highlightthickness=0,
                    padx=28, pady=13)

    def _build_compose_tab(self, parent):
        body = tk.Frame(parent, bg=C["bg"])
        body.pack(fill="both", expand=True, padx=28, pady=24)
        left = tk.Frame(body, bg=C["bg"], width=300)
        left.pack(side="left", fill="y", padx=(0, 20))
        left.pack_propagate(False)
        self._build_sidebar(left)
        right = tk.Frame(body, bg=C["bg"])
        right.pack(side="left", fill="both", expand=True)
        self._build_compose(right)

    def _build_howto_tab(self, parent):
        outer, inner = self._card(parent, padx=40, pady=36)
        outer.pack(fill="both", expand=True, padx=28, pady=24)

        def section(title, body_text):
            tk.Label(inner, text=title.upper(),
                     font=(_RB, 10, "bold"),
                     fg=C["accent"], bg=C["panel"]).pack(anchor="w", pady=(18, 4))
            tk.Frame(inner, bg=C["border"], height=1).pack(fill="x", pady=(0, 8))
            tk.Label(inner, text=body_text,
                     font=(_RB, 13),
                     fg=C["text"], bg=C["panel"],
                     justify="left", wraplength=820).pack(anchor="w")

        tk.Label(inner,
                 text="EWB-UH Email Blast — User Guide",
                 font=(_RB, 18, "bold"),
                 fg=C["accent"], bg=C["panel"]).pack(anchor="w")
        tk.Label(inner,
                 text="Written by Erick Miranda, 2025-2026 Chapter President",
                 font=(_RB, 11, "italic"),
                 fg=C["text_sub"], bg=C["panel"]).pack(anchor="w", pady=(4, 0))

        section("Overview",
            "This tool sends formatted HTML email reminders to EWB-UH members "
            "directly from uoh.ewb@gmail.com. No third-party service needed — "
            "it connects directly to Gmail over a secure SSL connection. "
            "The recipient list is saved automatically between sessions.")

        section("Step 1 — Add Recipients",
            "Type a username in the Add Recipient field on the left, then select "
            "the email domain from the dropdown (@gmail.com, @uh.edu, "
            "@cougarnet.uh.edu, etc.). Press Enter or click Add. "
            "To remove someone, click their address in the list and click Remove. "
            "The list saves to ewb_recipients.json in this folder automatically.")

        section("Step 2 — Fill In Sender Info",
            "Enter your name and position in the Sender Info fields. These appear "
            "in the email signature automatically. The signature reads: "
            "[Your Name] | [Your Position] | Engineers Without Borders | "
            "University of Houston Chapter")

        section("Step 3 — Choose a Template",
            "Select a template from the dropdown: General Body Meeting, Project "
            "Meeting, Board Meeting, Volunteer Event, or Other. The General Body "
            "and Volunteer templates are warm and student-friendly; Project "
            "Meeting is professional; Board Meeting is formal with a full agenda. "
            "Click Load to populate the Subject and Body fields. Then replace all "
            "[PLACEHOLDERS] — such as [DATE], [TIME], [LOCATION] — with the real "
            "event details. You can freely edit the body text.")

        section("Step 4 — Gmail App Password",
            "The App Password is a 16-character code generated by Google that "
            "allows this tool to send email on behalf of uoh.ewb@gmail.com. "
            "It is NOT your regular Gmail password. "
            "To get one: myaccount.google.com -> Security -> "
            "2-Step Verification -> App Passwords. "
            "Create one named EWB Email Blast. Google shows the code once — "
            "copy it and paste it into the App Password field. "
            "Click the Show/Hide button to reveal what you typed.")

        section("Step 5 — Attach Images (Optional)",
            "To include photos or flyers, click the + Attach Image button above "
            "the message body. You can select one or more images (PNG, JPG, GIF). "
            "They will be embedded inside the email so recipients see them inline, "
            "not as separate downloads. The count shows next to the button — click "
            "that text to clear all attached images. Keep each image under 10 MB. "
            "Note: pasting an image directly into the body text box does NOT work; "
            "always use the Attach Image button.")

        section("Step 6 — Preview and Send",
            "Click Preview to review the plain-text version of the email before "
            "sending. When ready, click Send Blast. The tool will ask for "
            "confirmation, then connect to Gmail and send individually to each "
            "recipient. A summary appears when complete showing sent and any failed.")

        section("Notes for Future Officers",
            "This script is plain Python — no installation beyond Anaconda is "
            "needed. To hand off to the next president: update the sender name and "
            "position fields, generate a new App Password for the new officer, and "
            "share this folder. The recipient list (ewb_recipients.json) carries "
            "over automatically. Contact Erick Miranda at erick202080@gmail.com "
            "or 832-872-5819 with questions.")




    def _build_header(self):
        # Thin navy top stripe
        tk.Frame(self, bg=C["header_top"], height=4).pack(fill="x")

        # Light blue header banner
        hdr = tk.Frame(self, bg=C["header_bg"])
        hdr.pack(fill="x")

        # Navy accent line beneath the banner
        tk.Frame(self, bg=C["header_line"], height=3).pack(fill="x")

        # Blue logo on the left (composited onto the light banner color)
        left_hdr = tk.Frame(hdr, bg=C["header_bg"], padx=26, pady=14)
        left_hdr.pack(side="left")
        logo_img = _build_logo_tk(60, bg_hex=C["header_bg"])
        if logo_img:
            tk.Label(left_hdr, image=logo_img,
                     bg=C["header_bg"]).pack(side="left")
        else:
            tk.Label(left_hdr, text="Engineers Without Borders",
                     font=(_RB, 15, "bold"),
                     fg=C["header_fg"], bg=C["header_bg"]).pack(anchor="w")

        # Tool name + sender on the right, in navy
        right_hdr = tk.Frame(hdr, bg=C["header_bg"], padx=26)
        right_hdr.pack(side="right", fill="y")
        rr = tk.Frame(right_hdr, bg=C["header_bg"])
        rr.pack(side="right", fill="y", expand=True)
        tk.Label(rr, text="Email Blast Tool",
                 font=(_RB, 16, "bold"),
                 fg=C["header_accent"], bg=C["header_bg"]).pack(anchor="e", pady=(16, 0))
        tk.Label(rr, text=f"Sending from   {SENDER_EMAIL}",
                 font=F["hdr_sub"], fg="#3A5578",
                 bg=C["header_bg"]).pack(anchor="e", pady=(3, 0))

    # ── Shared helpers ────────────────────────────────────────
    def _card(self, parent, bg=None, padx=22, pady=20):
        bg = bg or C["panel"]
        outer = tk.Frame(parent, bg=C["border"], padx=1, pady=1)
        inner = tk.Frame(outer, bg=bg, padx=padx, pady=pady)
        inner.pack(fill="both", expand=True)
        return outer, inner

    def _sec(self, parent, text, bg=None):
        bg = bg or C["panel"]
        tk.Label(parent, text=text.upper(),
                 font=F["section"], fg=C["text_sub"],
                 bg=bg).pack(anchor="w")
        tk.Frame(parent, bg=C["border"], height=1).pack(fill="x", pady=(5, 12))

    def _entry(self, parent, **kw):
        return tk.Entry(parent,
                        bg=C["entry_bg"], fg=C["entry_fg"],
                        insertbackground=C["accent"],
                        relief="flat",
                        highlightbackground=C["border"],
                        highlightcolor=C["border_focus"],
                        highlightthickness=1,
                        font=F["body"], **kw)

    def _btn(self, parent, text, cmd, bg, fg, width=None):
        kw = dict(text=text, command=cmd, bg=bg, fg=fg,
                  activebackground=C["accent_light"],
                  activeforeground=C["accent"],
                  font=F["btn_sm"], relief="flat", bd=0,
                  padx=16, pady=9, cursor="hand2")
        if width:
            kw["width"] = width
        return tk.Button(parent, **kw)

    # ── Sidebar ──────────────────────────────────────────────
    def _build_sidebar(self, parent):
        outer, inner = self._card(parent, bg=C["sidebar"], padx=16, pady=16)
        outer.pack(fill="both", expand=True)

        self._sec(inner, "Recipients", bg=C["sidebar"])

        lf = tk.Frame(inner, bg=C["border"], padx=1, pady=1)
        lf.pack(fill="both", expand=True)
        sb = tk.Scrollbar(lf, bd=0, width=10,
                          troughcolor=C["sidebar_list"])
        sb.pack(side="right", fill="y")
        self.recipient_listbox = tk.Listbox(
            lf, yscrollcommand=sb.set,
