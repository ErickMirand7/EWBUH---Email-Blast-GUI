def build_html_email(body_plain, name, position, image_cids=None):
    clean = body_plain.strip()
    if clean.endswith(SIGN_OFF):
        clean = clean[:-len(SIGN_OFF)].rstrip()
    html_body = "".join(
        '<p style="margin:0 0 18px;line-height:1.75;color:#0A0F1A;">'
        + p.replace("\n", "<br>") + "</p>"
        for p in clean.split("\n\n")
    )
    # Attached images embedded between body and signature
    images_html = ""
    if image_cids:
        images_html = '<div style="margin:8px 0 20px;">'
        for cid in image_cids:
            images_html += (
                f'<img src="cid:{cid}" '
                'style="max-width:100%;height:auto;border-radius:6px;'
                'margin-bottom:14px;display:block;">'
            )
        images_html += "</div>"
    # Logo embedded via Content-ID (cid) — see _send_emails attachment
    logo_html = (
        '<img src="cid:ewb_logo" alt="EWB-UH" '
        'style="height:56px;display:inline-block;">'
        if _LOGO_BYTES else ""
    )
    timestamp = datetime.now().strftime("%B %d, %Y at %I:%M %p")
    return f"""<!DOCTYPE html><html><head><meta charset="utf-8"></head>
<body style="margin:0;padding:0;background:#EEF2F8;">
<table width="100%" cellpadding="0" cellspacing="0"
  style="background:#EEF2F8;padding:40px 0;">
<tr><td align="center">
<table width="600" cellpadding="0" cellspacing="0"
  style="background:#fff;border-radius:6px;border:1px solid #D1D9E6;overflow:hidden;
         font-family:'Helvetica Neue',Arial,sans-serif;">
  <tr>
    <td style="background:#abcae9;padding:20px 36px;border-bottom:3px solid #0065b2;">
      <table width="100%" cellpadding="0" cellspacing="0"><tr>
        <td style="vertical-align:middle;">
          <span style="color:#0065b2;font-size:13px;font-weight:700;
                       letter-spacing:.6px;">
            ENGINEERS WITHOUT BORDERS<br>UNIVERSITY OF HOUSTON
          </span>
        </td>
        <td style="vertical-align:middle;text-align:right;">
          {logo_html}
        </td>
      </tr></table>
    </td>
  </tr>
  <tr>
    <td style="padding:36px 40px;font-size:15px;line-height:1.75;">
      {html_body}{images_html}{html_signature(name, position)}
    </td>
  </tr>
  <tr>
    <td style="background:#F0F4F9;padding:14px 40px;font-size:11px;
               color:#9CA3AF;border-top:1px solid #D1D9E6;letter-spacing:.4px;">
      ENGINEERS WITHOUT BORDERS &nbsp;|&nbsp; UNIVERSITY OF HOUSTON CHAPTER
      &nbsp;&nbsp;
      <a href="mailto:uoh.ewb@gmail.com"
         style="color:#0065b2;text-decoration:none;">uoh.ewb@gmail.com</a>
      <br><span style="color:#B6BEC9;">Sent {timestamp}</span>
    </td>
  </tr>
</table></td></tr></table></body></html>"""

