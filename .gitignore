def _resolve_ui_font():
    """If Roboto isn't installed, swap _RB to a clean system sans and
    rebuild the F dict. Hardcoded (_RB, ...) tuples read the updated global
    when their widgets are built. Must run after Tk() exists."""
    global _RB
    try:
        from tkinter import font as tkfont
        available = set(tkfont.families())
        if "Roboto" not in available:
            _RB = next((f for f in
                        ("Helvetica Neue", "Helvetica", "Arial", "San Francisco")
                        if f in available), "TkDefaultFont")
            for key, spec in list(F.items()):
                F[key] = (_RB,) + tuple(spec[1:])
    except Exception:
        pass


