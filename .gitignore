# ── Logo: load raw bytes at import (for email); PhotoImage built after Tk() ──
_LOGO_BYTES = None
_LOGO_TK    = None
if os.path.exists(LOGO_FILE):
    with open(LOGO_FILE, "rb") as _f:
        _LOGO_BYTES = _f.read()

def _build_logo_tk(target_h=52, bg_hex="#D6E4F5"):
    """Build a crisp blue logo composited onto the banner color. Call AFTER Tk()."""
    global _LOGO_TK
    src_bytes = _LOGO_BYTES  # blue logo
    if not src_bytes:
        return None
    try:
        from PIL import Image, ImageTk, ImageFilter
        img = Image.open(io.BytesIO(src_bytes)).convert("RGBA")
        r, g, b = tuple(int(bg_hex[i:i+2], 16) for i in (1, 3, 5))
        # Composite onto banner color at FULL resolution first
        bg_full = Image.new("RGBA", img.size, (r, g, b, 255))
        bg_full.paste(img, mask=img.split()[3])
        flat = bg_full.convert("RGB")
        # Step down gradually (halving) for cleaner anti-aliasing, then final
        disp_w = int(img.width * (target_h / img.height))
        cur = flat
        while cur.width > disp_w * 2:
            cur = cur.resize((cur.width // 2, cur.height // 2), Image.LANCZOS)
        final = cur.resize((disp_w, target_h), Image.LANCZOS)
        # Light sharpen to crisp up the downscaled edges
        final = final.filter(
            ImageFilter.UnsharpMask(radius=1.0, percent=80, threshold=2))
        _LOGO_TK = ImageTk.PhotoImage(final)
        return _LOGO_TK
    except Exception:
        return None

