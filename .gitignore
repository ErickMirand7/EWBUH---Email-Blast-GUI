                  highlightbackground="#CDD5E0",
                  padx=18, pady=10,
                  cursor="hand2").pack(side="left", padx=(0, 10))
        # On macOS tk.Button bg is unreliable; wrap in a navy Frame so the
        # color always shows. The Label acts as the button face.
        send_wrap = tk.Frame(btn_block, bg="#0065b2",
                             highlightbackground="#004a85",
                             highlightthickness=1)
        send_wrap.pack(side="left")
        send_lbl = tk.Label(send_wrap, text="Send Blast",
                            font=(_RB, 13, "bold"),
                            bg="#0065b2", fg="#FFFFFF",
                            padx=24, pady=11, cursor="hand2")
        send_lbl.pack()
        send_lbl.bind("<Button-1>", lambda e: self._send_emails())
        send_lbl.bind("<Enter>", lambda e: send_lbl.config(bg="#004a85"))
        send_lbl.bind("<Leave>", lambda e: send_lbl.config(bg="#0065b2"))

        # ── Body text fills remaining space above action bar ──
        bf = tk.Frame(inner, bg=C["border"], padx=1, pady=1)
        bf.pack(side="top", fill="both", expand=True)
        bsb = tk.Scrollbar(bf, bd=0, width=10)
        bsb.pack(side="right", fill="y")
        self.body_text = tk.Text(
            bf, yscrollcommand=bsb.set,
            bg=C["entry_bg"], fg=C["text"],
            insertbackground=C["accent"],
            font=F["body"], relief="flat", bd=0,
            wrap="word", padx=14, pady=12,
            selectbackground=C["select"],
            highlightthickness=0,
            spacing1=2, spacing3=2)
        self.body_text.pack(fill="both", expand=True)
        bsb.config(command=self.body_text.yview)
        self.body_text.bind("<Command-z>",
            lambda e: (self.body_text.edit_undo(), "break"))
        self.body_text.bind("<Command-Z>",
            lambda e: (self.body_text.edit_redo(), "break"))
        self.body_text.bind("<Control-z>",
            lambda e: (self.body_text.edit_undo(), "break"))
        self.body_text.bind("<Control-y>",
            lambda e: (self.body_text.edit_redo(), "break"))
        self.body_text.config(undo=True, maxundo=50)
        self._load_template()



    # ── Logic ────────────────────────────────────────────────
    def _update_count(self):
        n = len(self.recipients)
        self.count_var.set(f"{n} recipient{'s' if n != 1 else ''}")

    def _update_sig_preview(self):
        name = self.sender_name.get().strip() or "[Name]"
        pos  = self.sender_position.get().strip() or "[Position]"
        self.sig_preview_var.set(
            f"Signature  |  {name}  |  {pos}  |  "
            "Engineers Without Borders - UH")

    def _add_recipient(self):
        username = self.username_entry.get().strip()
        domain   = self.domain_var.get().strip()
        if not username:
            return
        email = username if "@" in username else username + domain
        if "@" not in email or "." not in email.split("@")[-1]:
            messagebox.showerror("Invalid Email",
                f'"{email}" is not a valid address.')
            return
        if email in self.recipients:
            messagebox.showwarning("Duplicate",
                f"{email} is already in the list.")
            return
        self.recipients.append(email)
        self.recipient_listbox.insert(tk.END, email)
        save_recipients(self.recipients)
        self.username_entry.delete(0, tk.END)
        self._update_count()

    def _remove_recipient(self):
        sel = self.recipient_listbox.curselection()
        if not sel:
            messagebox.showinfo("Select a recipient",
                "Click an email address in the list to select it.")
            return
        idx   = sel[0]
        email = self.recipients[idx]
        if messagebox.askyesno("Remove Recipient",
                f"Remove {email} from the list?"):
            self.recipients.pop(idx)
            self.recipient_listbox.delete(idx)
            save_recipients(self.recipients)
            self._update_count()

    def _load_template(self, _=None):
        t = TEMPLATES[self.template_var.get()]
        self.subject_entry.delete(0, tk.END)
        self.subject_entry.insert(0, t["subject"])
        self.body_text.delete("1.0", tk.END)
        self.body_text.insert("1.0", t["body"])

    def _get_composed(self):
        date_val = self.date_entry.get().strip() or datetime.now().strftime("%B %d, %Y")
        body_raw = self.body_text.get("1.0", tk.END).strip()
        body_raw = body_raw.replace("[DATE]", date_val)
        return (
            self.subject_entry.get().strip(),
            body_raw,
            self.sender_name.get().strip() or "[Insert Name]",
            self.sender_position.get().strip() or "[Insert Position]",
        )

    def _attach_image(self):
        paths = filedialog.askopenfilenames(
            title="Attach images or files (PDF, etc.)",
            filetypes=[("Images & PDFs", "*.png *.jpg *.jpeg *.gif *.webp *.pdf"),
                       ("Images", "*.png *.jpg *.jpeg *.gif *.webp"),
                       ("PDF", "*.pdf"),
                       ("All files", "*.*")])
        if not paths:
            return
        for p in paths:
            try:
                with open(p, "rb") as f:
                    data = f.read()
                if len(data) > 20 * 1024 * 1024:
                    messagebox.showwarning("File too large",
                        f"{os.path.basename(p)} is over 20 MB and was skipped.\n"
                        "Gmail's total message limit is 25 MB.")
                    continue
                ext = os.path.splitext(p)[1].lstrip(".").lower()
                is_image = ext in ("png", "jpg", "jpeg", "gif", "webp")
                cid = f"img{len(self.attached_images)}"
                # tuple: (filename, bytes, cid, is_image)
                self.attached_images.append(
                    (os.path.basename(p), data, cid, is_image))
            except Exception as e:
                messagebox.showerror("Could not attach",
                    f"{os.path.basename(p)}: {e}")
        self._update_img_count()

    def _clear_images(self):
        self.attached_images = []
        self._update_img_count()

    def _update_img_count(self):
        n = len(self.attached_images)
        if n == 0:
            self.img_count_var.set("")
        else:
            names = ", ".join(a[0] for a in self.attached_images[:2])
            extra = f" +{n-2} more" if n > 2 else ""
            self.img_count_var.set(f"{n} attachment(s): {names}{extra}  (click to clear)")

    def _preview(self):
        subject, body, name, position = self._get_composed()
        display = (body.replace("[Insert Name]", name)
                       .replace("[Insert Position]", position))
        win = tk.Toplevel(self)
        win.title("Preview")
        win.geometry("740x660")
        win.configure(bg=C["bg"])

        ho, hi = self._card(win, padx=20, pady=16)
        ho.pack(fill="x", padx=24, pady=(20, 0))
        tk.Label(hi, text=subject,
                 font=(_RB, 14, "bold"),
                 fg=C["text"], bg=C["panel"],
                 wraplength=680, justify="left").pack(anchor="w")
        tk.Label(hi,
                 text=f"To: {len(self.recipients)} recipient(s)     "
                      f"From: {SENDER_EMAIL}",
                 font=F["small"], fg=C["text_sub"],
                 bg=C["panel"]).pack(anchor="w", pady=(5, 2))
        img_note = (f"  {len(self.attached_images)} attachment(s) included."
                    if self.attached_images else "")
        tk.Label(hi,
                 text="Recipients receive a styled HTML email." + img_note,
                 font=(_RB, 10, "italic"),
                 fg=C["text_sub"], bg=C["panel"]).pack(anchor="w")

        tk.Frame(win, bg=C["border"], height=1).pack(fill="x", padx=24, pady=10)

        bo, bi = self._card(win, padx=0, pady=0)
        bo.pack(fill="both", expand=True, padx=24, pady=(0, 24))
        tsb = tk.Scrollbar(bi, bd=0, width=10)
        tsb.pack(side="right", fill="y")
        txt = tk.Text(bi, yscrollcommand=tsb.set,
                      bg=C["entry_bg"], fg=C["text"],
                      font=F["body"], relief="flat", bd=0,
                      wrap="word", padx=16, pady=14,
                      highlightthickness=0)
        txt.pack(fill="both", expand=True)
        tsb.config(command=txt.yview)
        txt.insert("1.0", display)
        txt.config(state="disabled")

    def _send_emails(self):
        subject, body, name, position = self._get_composed()
        password = APP_PASSWORD
        if not subject:
            messagebox.showerror("Missing", "Please enter a subject."); return
        if not body:
            messagebox.showerror("Missing", "Body cannot be empty."); return
        if not self.recipients:
            messagebox.showerror("No Recipients",
                "Add at least one recipient."); return

        final_body = (body.replace("[Insert Name]", name)
                          .replace("[Insert Position]", position))

        # ── Two-step confirmation dialog ──────────────────────
        confirm_win = tk.Toplevel(self)
        confirm_win.title("Confirm Send")
        confirm_win.geometry("520x480")
        confirm_win.configure(bg=C["bg"])
        confirm_win.resizable(False, False)
        confirm_win.grab_set()   # modal

        co, ci = self._card(confirm_win, padx=28, pady=24)
        co.pack(fill="both", expand=True, padx=20, pady=20)

        tk.Label(ci, text="Ready to Send?",
                 font=(_RB, 16, "bold"),
                 fg=C["accent"], bg=C["panel"]).pack(anchor="w")
        tk.Frame(ci, bg=C["border"], height=1).pack(fill="x", pady=(8, 14))

        def row(label, value):
            f = tk.Frame(ci, bg=C["panel"])
            f.pack(fill="x", pady=3)
            tk.Label(f, text=label, font=F["section"],
                     fg=C["text_sub"], bg=C["panel"],
                     width=14, anchor="w").pack(side="left")
            tk.Label(f, text=value, font=F["body"],
                     fg=C["text"], bg=C["panel"],
                     anchor="w", wraplength=320,
                     justify="left").pack(side="left")

        row("Subject:", subject)
        row("From:", SENDER_EMAIL)
        row("Recipients:", str(len(self.recipients)))
        row("Sender Name:", name)
        row("Position:", position)
        row("Date:", self.date_entry.get().strip())
        if self.attached_images:
            row("Attachments:", f"{len(self.attached_images)} file(s)")

        # Recipient preview list
        tk.Frame(ci, bg=C["border"], height=1).pack(fill="x", pady=(12, 6))
        tk.Label(ci, text="RECIPIENT LIST",
                 font=F["section"], fg=C["text_sub"],
                 bg=C["panel"]).pack(anchor="w", pady=(0, 4))
        preview_list = "\n".join(self.recipients[:6])
        if len(self.recipients) > 6:
            preview_list += f"\n  ... and {len(self.recipients)-6} more"
        tk.Label(ci, text=preview_list,
                 font=F["small"], fg=C["text"],
                 bg=C["panel"], justify="left").pack(anchor="w")

        tk.Frame(ci, bg=C["border"], height=1).pack(fill="x", pady=(14, 0))

        confirmed = tk.BooleanVar(value=False)

        def do_send():
            confirmed.set(True)
            confirm_win.destroy()

        def do_cancel():
            confirm_win.destroy()

        btn_row = tk.Frame(ci, bg=C["panel"])
        btn_row.pack(fill="x", pady=(12, 0))
        tk.Button(btn_row, text="Cancel",
                  font=(_RB, 12, "bold"),
                  bg="#FFFFFF", fg="#000000",
                  activebackground="#E2EAF6",
                  activeforeground="#000000",
                  relief="solid", bd=1,
                  highlightbackground="#CDD5E0",
                  padx=18, pady=9, cursor="hand2",
                  command=do_cancel).pack(side="right", padx=(8, 0))
        yes_wrap = tk.Frame(btn_row, bg="#0065b2",
                           highlightbackground="#004a85",
                           highlightthickness=1)
        yes_wrap.pack(side="right")
        yes_lbl = tk.Label(yes_wrap, text="Yes, Send Blast",
                          font=(_RB, 13, "bold"),
                          bg="#0065b2", fg="#FFFFFF",
                          padx=24, pady=11, cursor="hand2")
        yes_lbl.pack()
        yes_lbl.bind("<Button-1>", lambda e: do_send())
        yes_lbl.bind("<Enter>", lambda e: yes_lbl.config(bg="#004a85"))
        yes_lbl.bind("<Leave>", lambda e: yes_lbl.config(bg="#0065b2"))

        self.wait_window(confirm_win)
        if not confirmed.get():
            return

        # Only image attachments get inline cids; PDFs/files attach normally
        image_cids = [a[2] for a in self.attached_images if a[3]]
        html_out  = build_html_email(final_body, name, position, image_cids)
        plain_out = final_body + "\n\nuoh.ewb@gmail.com  |  832-872-5819"

        # Show a "sending..." status so the user doesn't click again
        self._show_sending_overlay(len(self.recipients))
        self.update_idletasks()  # render the status before the blocking send

        try:
            srv = smtplib.SMTP_SSL("smtp.gmail.com", 465)
            srv.login(SENDER_EMAIL, APP_PASSWORD)
            sent, failed = [], []
            for i, addr in enumerate(self.recipients, 1):
                try:
                    msg = MIMEMultipart("related")
                    msg["Subject"] = subject
                    msg["From"]    = f"EWB-UH <{SENDER_EMAIL}>"
                    msg["To"]      = addr
                    alt = MIMEMultipart("alternative")
                    alt.attach(MIMEText(plain_out, "plain", "utf-8"))
                    alt.attach(MIMEText(html_out,  "html",  "utf-8"))
                    msg.attach(alt)
                    from email.mime.image import MIMEImage
                    from email.mime.application import MIMEApplication
                    if _LOGO_BYTES:
                        lp = MIMEImage(_LOGO_BYTES, _subtype="png")
                        lp.add_header("Content-ID", "<ewb_logo>")
                        lp.add_header("Content-Disposition", "inline",
                                      filename="ewb_logo.png")
                        msg.attach(lp)
                    # Attach user files: images inline (cid), others as files
                    for (fname, data, cid, is_image) in self.attached_images:
                        if is_image:
                            ext = os.path.splitext(fname)[1].lstrip(".").lower() or "png"
                            if ext == "jpg":
                                ext = "jpeg"
                            ip = MIMEImage(data, _subtype=ext)
                            ip.add_header("Content-ID", f"<{cid}>")
                            ip.add_header("Content-Disposition", "inline",
                                          filename=fname)
                            msg.attach(ip)
                        else:
                            ap = MIMEApplication(data)
                            ap.add_header("Content-Disposition", "attachment",
                                          filename=fname)
                            msg.attach(ap)
                    srv.sendmail(SENDER_EMAIL, addr, msg.as_string())
                    sent.append(addr)
                    # Update progress
                    self._update_sending_overlay(i, len(self.recipients))
                    self.update_idletasks()
                except Exception as e:
                    failed.append(f"{addr} - {e}")
            srv.quit()
            self._hide_sending_overlay()
            ts = datetime.now().strftime("%B %d, %Y at %I:%M %p")
            result = f"Sent successfully to {len(sent)} recipient(s).\n\nSent on {ts}"
            if failed:
                result += f"\n\nFailed ({len(failed)}):\n" + "\n".join(failed)
            messagebox.showinfo("Send Complete", result)
            # Update the status line in the GUI
            if hasattr(self, "status_var"):
                self.status_var.set(f"Last blast sent {ts}  —  {len(sent)} recipient(s)")
        except smtplib.SMTPAuthenticationError:
            self._hide_sending_overlay()
            messagebox.showerror("Authentication Failed",
                "Gmail rejected the login.\n\n"
                "Use a Gmail App Password, not your regular password.\n"
                "myaccount.google.com -> Security -> App Passwords")
        except Exception as e:
            self._hide_sending_overlay()
            messagebox.showerror("Connection Error",
                f"Could not connect to Gmail:\n{e}")

    # ── Sending overlay (prevents double-send clicks) ─────────
    def _show_sending_overlay(self, total):
        # Non-modal: just update the status line and disable nothing fragile.
        if hasattr(self, "status_var"):
            self.status_var.set(
                f"Sending to {total} recipient(s)... please wait, do not click again")
        self.config(cursor="watch")

    def _update_sending_overlay(self, done, total):
        if hasattr(self, "status_var"):
            self.status_var.set(f"Sending... {done} of {total} sent")

    def _hide_sending_overlay(self):
        self.config(cursor="")

if __name__ == "__main__":
    app = EWBEmailApp()
    app.mainloop()
